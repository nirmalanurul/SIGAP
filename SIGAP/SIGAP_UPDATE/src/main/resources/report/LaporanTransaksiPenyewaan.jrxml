	<query language="SQL"><![CDATA[
SELECT
    Id_Penyewaan,
    Id_Karyawan,
    Id_Penyewa,
    Id_Kios,
    Tgl_Mulai,
    Tgl_Selesai,
    Tgl_Penyewaan,
    Sts_Penyewaan
FROM tbPenyewaan
ORDER BY Tgl_Penyewaan DESC
	]]></query>
	<field name="Id_Penyewaan" class="java.lang.String"/>
	<field name="Id_Karyawan" class="java.lang.String"/>
	<field name="Id_Penyewa" class="java.lang.String"/>
	<field name="Id_Kios" class="java.lang.String"/>
	<field name="Tgl_Mulai" class="java.sql.Date"/>
	<field name="Tgl_Selesai" class="java.sql.Date"/>
	<field name="Tgl_Penyewaan" class="java.sql.Date"/>
	<field name="Sts_Penyewaan" class="java.lang.String"/>
	<variable name="jumlahTransaksi" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{Id_Penyewaan}]]></expression>
	</variable>
