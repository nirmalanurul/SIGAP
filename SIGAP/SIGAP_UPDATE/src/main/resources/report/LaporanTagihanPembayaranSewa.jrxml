	<query language="SQL"><![CDATA[
SELECT
    Id_Tagihan_Pembayaran,
    Id_Penyewaan,
    Id_Karyawan,
    Tgl_Bayar,
    Tgl_Jatuh_Tempo,
    Total_Biaya_Sewa,
    Total_Biaya_Tambahan,
    Total_Tagihan,
    Total_Dibayar,
    Metode_Bayar,
    Sts_Tagihan_Pembayaran
FROM tbTagihanPembayaranSewa
ORDER BY Tgl_Jatuh_Tempo DESC
	]]></query>
	<field name="Id_Tagihan_Pembayaran" class="java.lang.String"/>
	<field name="Id_Penyewaan" class="java.lang.String"/>
	<field name="Id_Karyawan" class="java.lang.String"/>
	<field name="Tgl_Bayar" class="java.sql.Date"/>
	<field name="Tgl_Jatuh_Tempo" class="java.sql.Date"/>
	<field name="Total_Biaya_Sewa" class="java.math.BigDecimal"/>
	<field name="Total_Biaya_Tambahan" class="java.math.BigDecimal"/>
	<field name="Total_Tagihan" class="java.math.BigDecimal"/>
	<field name="Total_Dibayar" class="java.math.BigDecimal"/>
	<field name="Metode_Bayar" class="java.lang.String"/>
	<field name="Sts_Tagihan_Pembayaran" class="java.lang.String"/>
	<variable name="subtotalTagihanHalaman" resetType="Page" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{Total_Tagihan}]]></expression>
	</variable>
	<variable name="subtotalDibayarHalaman" resetType="Page" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{Total_Dibayar}]]></expression>
	</variable>
	<variable name="totalPendapatanKeseluruhan" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{Total_Tagihan}]]></expression>
	</variable>
	<variable name="totalDibayarKeseluruhan" calculation="Sum" class="java.math.BigDecimal">
		<expression><![CDATA[$F{Total_Dibayar}]]></expression>
	</variable>
	<variable name="jumlahTagihan" calculation="Count" class="java.lang.Integer">
		<expression><![CDATA[$F{Id_Tagihan_Pembayaran}]]></expression>
	</variable>
