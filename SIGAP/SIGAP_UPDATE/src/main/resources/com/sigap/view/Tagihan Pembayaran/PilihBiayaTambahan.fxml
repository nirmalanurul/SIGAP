<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<!-- SESUAIKAN: styling / fx:id sudah konsisten dengan pola PilihPenyewaan &
     PilihBulanTagihan, tapi cocokkan lagi warna/font kalau kamu punya
     stylesheet global (mis. lewat @styles.css) supaya seragam. -->
<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.sigap.controller.PilihBiayaTambahanController"
            prefWidth="820" prefHeight="520">

    <top>
        <Label text="Tambah Biaya Tambahan" style="-fx-font-size:18px;-fx-font-weight:700;-fx-padding:16 20 8 20;" />
    </top>

    <center>
        <HBox spacing="16" style="-fx-padding:0 20 12 20;">

            <!-- Kolom kiri: master biaya tambahan aktif -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="420">
                <Label text="Biaya Tambahan Tersedia" style="-fx-font-weight:600;" />
                <TableView fx:id="tabelTersedia" onMouseClicked="#onRowTersediaClicked" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdTersedia" text="ID" prefWidth="60" />
                        <TableColumn fx:id="colJenisTersedia" text="Jenis Biaya" prefWidth="150" />
                        <TableColumn fx:id="colNominalTersedia" text="Nominal / Hari" prefWidth="110" />
                        <TableColumn fx:id="colKeteranganTersedia" text="Keterangan" prefWidth="110" />
                        <TableColumn fx:id="colStatusTersedia" text="Status" prefWidth="80" />
                    </columns>
                </TableView>
                <HBox spacing="8" alignment="CENTER_LEFT">
                    <Label text="Jumlah Hari:" />
                    <TextField fx:id="txtJumlahHari" promptText="0 (otomatis utk Keterlambatan)" prefWidth="170" />
                    <Button fx:id="btnTambahKeDaftar" text="+ Tambah ke Daftar" onAction="#onTambahKeDaftar" />
                </HBox>
            </VBox>

            <!-- Kolom kanan: biaya yang sudah dipilih untuk tagihan ini -->
            <VBox spacing="8" HBox.hgrow="ALWAYS" prefWidth="360">
                <Label text="Biaya Terpilih untuk Tagihan Ini" style="-fx-font-weight:600;" />
                <TableView fx:id="tabelDipilih" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdDipilih" text="ID Biaya" prefWidth="70" />
                        <TableColumn fx:id="colJenisDipilih" text="Jenis Biaya" prefWidth="120" />
                        <TableColumn fx:id="colJumlahHariDipilih" text="Jml Hari" prefWidth="60" />
                        <TableColumn fx:id="colSubtotalDipilih" text="Sub Total" prefWidth="90" />
                        <TableColumn fx:id="colHapus" text="" prefWidth="60" />
                    </columns>
                </TableView>
                <HBox alignment="CENTER_RIGHT" spacing="6">
                    <Label text="Total Biaya Tambahan:" style="-fx-font-weight:600;" />
                    <Label fx:id="lblTotalBiayaTambahan" text="Rp 0" style="-fx-font-weight:700;-fx-text-fill:#1A3A8F;" />
                </HBox>
            </VBox>

        </HBox>
    </center>

    <bottom>
        <HBox spacing="10" alignment="CENTER_RIGHT" style="-fx-padding:8 20 16 20;">
            <Button fx:id="btnBatal" text="Batal" onAction="#onBatal"
                    style="-fx-background-color:#EAEAEA;-fx-text-fill:#555;-fx-padding:8 20;-fx-background-radius:6;" />
            <Button fx:id="btnSelesai" text="Selesai" onAction="#onSelesai"
                    style="-fx-background-color:#1A3A8F;-fx-text-fill:white;-fx-font-weight:600;-fx-padding:8 20;-fx-background-radius:6;" />
        </HBox>
    </bottom>

</BorderPane>
