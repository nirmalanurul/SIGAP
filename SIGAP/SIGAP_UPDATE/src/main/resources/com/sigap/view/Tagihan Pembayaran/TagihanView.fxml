<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuButton?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.RadioMenuItem?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<ScrollPane fitToWidth="true" style="-fx-background-color: transparent; -fx-background-insets: 0; -fx-padding: 0;" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.sigap.controller.TagihanController">
    <content>/
        <VBox spacing="20.0">
            <padding>
                <Insets bottom="24.0" left="24.0" right="24.0" top="20.0" />
            </padding>
            <children>

                <VBox spacing="4.0">
                    <children>
                        <Label style="-fx-font-size: 12px; -fx-text-fill: #888;" text="Transaksi  ›  Tagihan Pembayaran Sewa" />
                        <Label style="-fx-font-size: 26px; -fx-font-weight: 900; -fx-text-fill: #1A2340;" text="Data Tagihan Pembayaran Sewa" />
                        <Label style="-fx-font-size: 13px; -fx-text-fill: #888;" text="Kelola tagihan pembayaran sewa kios sistem SIGAP" />
                    </children>
                </VBox>

                <VBox spacing="16.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,2);">
                    <padding>
                        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Rectangle arcHeight="4" arcWidth="4" fill="#1A3A8F" height="20" width="4" />
                                <Label style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1A3A8F;" text="Form Transaksi Tagihan Pembayaran Sewa" />
                            </children>
                        </HBox>

                        <GridPane hgap="30.0" vgap="14.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="NEVER" minWidth="140.0" prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="200.0" />
                                <ColumnConstraints hgrow="NEVER" minWidth="140.0" prefWidth="140.0" />
                                <ColumnConstraints hgrow="ALWAYS" minWidth="200.0" prefWidth="200.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="62.0" prefHeight="62.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                                <RowConstraints minHeight="34.0" prefHeight="34.0" vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>


                                <HBox alignment="CENTER_LEFT" spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="0">
                                    <children>
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="ID Tagihan" />
                                    </children>
                                </HBox>
                                <TextField fx:id="txtIdTagihan" editable="false" maxWidth="1.7976931348623157E308" promptText="Auto-generate" style="-fx-background-color: #F8F9FC; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="0" />

                                <HBox alignment="CENTER_LEFT" spacing="2.0" GridPane.columnIndex="0" GridPane.rowIndex="1">
                                    <children>
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Penyewaan" />
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #D63030;" text="*" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="1" GridPane.rowIndex="1">
                                    <children>
                                        <TextField fx:id="txtPenyewaanTerpilih" editable="false" maxWidth="1.7976931348623157E308" promptText="Belum dipilih" style="-fx-background-color: #F8F9FC; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnPilihPenyewaan" onAction="#onPilihPenyewaan" prefHeight="32" prefWidth="90" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-size: 12px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-border-color: #1A3A8F; -fx-border-radius: 6; -fx-cursor: hand;" text="Pilih" />
                                    </children>
                                </HBox>

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Karyawan" GridPane.columnIndex="0" GridPane.rowIndex="2" />
                                <TextField fx:id="txtNamaKaryawan" editable="false" maxWidth="1.7976931348623157E308" style="-fx-background-color: #F8F9FC; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="2" />

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Tgl. Bayar" GridPane.columnIndex="0" GridPane.rowIndex="3" />
                                <TextField fx:id="txtTglBayar" editable="false" maxWidth="1.7976931348623157E308" style="-fx-background-color: #F8F9FC; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" GridPane.columnIndex="1" GridPane.rowIndex="3" />

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Tgl. Jatuh Tempo" GridPane.columnIndex="0" GridPane.rowIndex="4" />
                                <TextField fx:id="txtTglJatuhTempo" editable="false" maxWidth="1.7976931348623157E308" promptText="Otomatis dari Pilih Penyewaan" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px; -fx-text-fill: #888;" GridPane.columnIndex="1" GridPane.rowIndex="4" />

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Total Biaya Sewa (Rp)" GridPane.columnIndex="0" GridPane.rowIndex="5" />
                                <TextField fx:id="txtTotalBiayaSewa" editable="false" maxWidth="1.7976931348623157E308" promptText="Otomatis dari Pilih Penyewaan" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px; -fx-text-fill: #888;" GridPane.columnIndex="1" GridPane.rowIndex="5" />

                                <!-- Kolom kanan -->

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Dibayar di Awal (Rp)" GridPane.columnIndex="2" GridPane.rowIndex="0" />
                                <TextField fx:id="txtTotalDibayarAwal" maxWidth="1.7976931348623157E308" promptText="0" style="-fx-background-color: WHITE; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" GridPane.columnIndex="3" GridPane.rowIndex="0" />

                                <HBox alignment="CENTER_LEFT" spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="1">
                                    <children>
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Total Biaya Tambahan (Rp)" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT" spacing="10.0" GridPane.columnIndex="3" GridPane.rowIndex="1">
                                    <children>
                                        <TextField fx:id="txtTotalBiayaTambahan" editable="false" maxWidth="1.7976931348623157E308" promptText="0" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px; -fx-text-fill: #888;" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnPilihBiayaTambahan" onAction="#onPilihBiayaTambahan" prefHeight="32" prefWidth="130" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-size: 12px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-border-color: #1A3A8F; -fx-border-radius: 6; -fx-cursor: hand;" text="+ Biaya Tambahan" />
                                    </children>
                                </HBox>

                                  <HBox alignment="CENTER_LEFT" spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="2">
                                    <children>
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Total Dibayar (Rp)" />
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #D63030;" text="*" />
                                    </children>
                                </HBox>
                                <VBox spacing="4.0" GridPane.columnIndex="3" GridPane.rowIndex="2">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label style="-fx-font-size: 11px; -fx-text-fill: #888;" text="Sudah Dibayar:" />
                                                <TextField fx:id="txtSudahDibayar" editable="false" prefWidth="130" style="-fx-background-color: #F8F9FC; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 4 10; -fx-font-size: 12px;" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <TextField fx:id="txtNominalBayar" maxWidth="1.7976931348623157E308" promptText="Nominal bayar (harus lunas)" style="-fx-background-color: WHITE; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px;" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnOtomatis" onAction="#onIsiOtomatis" prefHeight="32" prefWidth="32" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-size: 15px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-border-color: #1A3A8F; -fx-border-radius: 6; -fx-cursor: hand;" text="⟳" />
                                                <Button fx:id="btnBayar" onAction="#onBayar" prefHeight="32" prefWidth="86" style="-fx-background-color: #2ECC71; -fx-text-fill: WHITE; -fx-font-size: 12px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-cursor: hand;" text="BAYAR" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Total Tagihan (Rp)" GridPane.columnIndex="2" GridPane.rowIndex="3" />
                                <TextField fx:id="txtTotalTagihan" editable="false" maxWidth="1.7976931348623157E308" promptText="Dihitung otomatis saat disimpan" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px; -fx-text-fill: #888;" GridPane.columnIndex="3" GridPane.rowIndex="3" />

                                <HBox alignment="CENTER_LEFT" spacing="2.0" GridPane.columnIndex="2" GridPane.rowIndex="4">
                                    <children>
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Metode Bayar" />
                                        <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #D63030;" text="*" />
                                    </children>
                                </HBox>
                                <ComboBox fx:id="cbMetodeBayar" maxWidth="1.7976931348623157E308" promptText="Pilih metode bayar" style="-fx-background-color: WHITE; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-font-size: 13px;" GridPane.columnIndex="3" GridPane.rowIndex="4" />

                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Status" GridPane.columnIndex="2" GridPane.rowIndex="5" />
                                <TextField fx:id="txtStatus" editable="false" maxWidth="1.7976931348623157E308" style="-fx-background-color: #F0F0F0; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 12; -fx-font-size: 13px; -fx-text-fill: #888;" GridPane.columnIndex="3" GridPane.rowIndex="5" />

                            </children>
                        </GridPane>
                    </children>
                </VBox>

                <VBox spacing="12.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,2);">
                    <padding>
                        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Rectangle arcHeight="4" arcWidth="4" fill="#1A3A8F" height="20" width="4" />
                                <Label style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1A3A8F;" text="Biaya Tambahan" />
                            </children>
                        </HBox>

                        <TableView fx:id="tabelBiayaTambahan" prefHeight="140" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="NEVER">
                            <columns>
                                <TableColumn fx:id="colJenisBiayaTambahan" prefWidth="220" text="Jenis Biaya" />
                                <TableColumn fx:id="colJumlahHariBiaya" prefWidth="90" text="Jml Hari" />
                                <TableColumn fx:id="colSubtotalBiaya" prefWidth="130" text="Sub Total" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #AAA;" text="Belum ada biaya tambahan." />
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="6.0">
                            <children>
                                <Label style="-fx-font-size: 13px; -fx-font-weight: 600; -fx-text-fill: #333;" text="Total Biaya Tambahan:" />
                                <Label fx:id="lblTotalBiayaTambahan" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #1A3A8F;" text="Rp 0" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <children>
                        <HBox spacing="8.0" HBox.hgrow="ALWAYS">
                            <children>

                                <Button fx:id="btnSimpan" onAction="#onSimpan" prefHeight="38" prefWidth="120" style="-fx-background-color: #1A3A8F; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-cursor: hand;" text="SIMPAN" />
                                <Button onAction="#onBersih" prefHeight="38" prefWidth="110" style="-fx-background-color: #A0A8B8; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-cursor: hand;" text="BATAL" />
                            </children>
                        </HBox>
                        <HBox spacing="8.0">
                            <children>
                                <TextField fx:id="txtCari" prefHeight="38" prefWidth="260" promptText="Cari ID / Penyewaan / Nama Penyewa / Status" style="-fx-background-color: WHITE; -fx-border-color: #D0D8E8; -fx-border-radius: 6; -fx-background-radius: 6; -fx-padding: 6 14; -fx-font-size: 13px;" />
                                <Button onAction="#onCari" prefHeight="38" prefWidth="94" style="-fx-background-color: #1A3A8F; -fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: 700; -fx-background-radius: 6; -fx-cursor: hand;" text="CARI" />
                                <MenuButton fx:id="btnFilter" contentDisplay="GRAPHIC_ONLY" prefHeight="38" style="-fx-background-color: #1A3A8F; -fx-background-radius: 6; -fx-cursor: hand; -fx-mark-color: WHITE; -fx-padding: 6 6 6 14;">
                                    <graphic>
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label style="-fx-text-fill: WHITE; -fx-font-size: 13px; -fx-font-weight: 700;" text="FILTER" />
                                            </children>
                                        </HBox>
                                    </graphic>
                                    <items>
                                        <Menu fx:id="menuPenyewaan" style="-fx-text-fill: #333333;" text="Penyewaan" />
                                        <Menu style="-fx-text-fill: #333333;" text="Status">
                                            <items>
                                                <RadioMenuItem fx:id="rmStatusBelumLunas" onAction="#onFilterStatus" style="-fx-text-fill: #333333;" text="Belum Lunas" />
                                                <RadioMenuItem fx:id="rmStatusLunas" onAction="#onFilterStatus" style="-fx-text-fill: #333333;" text="Lunas" />
                                                <RadioMenuItem fx:id="rmStatusTerlambat" onAction="#onFilterStatus" style="-fx-text-fill: #333333;" text="Terlambat" />
                                                <RadioMenuItem fx:id="rmStatusDibatalkan" onAction="#onFilterStatus" style="-fx-text-fill: #333333;" text="Dibatalkan" />
                                            </items>
                                        </Menu>
                                        <MenuItem onAction="#onResetFilter" style="-fx-text-fill: #333333;" text="Reset Filter" />
                                    </items>
                                </MenuButton>
                            </children>
                        </HBox>
                    </children>
                </HBox>

                <VBox spacing="16.0" style="-fx-background-color: WHITE; -fx-background-radius: 10; -fx-effect: dropshadow(gaussian,rgba(0,0,0,0.07),10,0,0,2);">
                    <padding>
                        <Insets bottom="16.0" left="20.0" right="20.0" top="16.0" />
                    </padding>
                    <children>

                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Rectangle arcHeight="4" arcWidth="4" fill="#1A3A8F" height="20" width="4" />
                                <Label style="-fx-font-size: 15px; -fx-font-weight: 700; -fx-text-fill: #1A3A8F;" text="Daftar Tagihan Pembayaran Sewa" />
                            </children>
                        </HBox>

                        <TableView fx:id="tabelTagihan" onMouseClicked="#onTableClick" prefHeight="360" style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colId" prefWidth="80" text="ID" />
                                <TableColumn fx:id="colPenyewaan" prefWidth="190" text="Penyewaan" />
                                <TableColumn fx:id="colKaryawan" prefWidth="80" text="Karyawan" />
                                <TableColumn fx:id="colTglBayar" prefWidth="110" text="Tgl Bayar" />
                                <TableColumn fx:id="colTglTempo" prefWidth="110" text="Jatuh Tempo" />
                                <TableColumn fx:id="colTotalTagihan" prefWidth="110" text="Total Tagihan" />
                                <TableColumn fx:id="colTotalDibayar" prefWidth="110" text="Total Dibayar" />
                                <TableColumn fx:id="colStatus" prefWidth="100" text="Status" />
                            </columns>
                            <placeholder>
                                <Label style="-fx-font-size: 13px; -fx-text-fill: #AAA;" text="Tidak ada data tagihan pembayaran." />
                            </placeholder>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Label fx:id="lblTotal" style="-fx-font-size: 13px; -fx-text-fill: #555; -fx-font-weight: 600;" text="Total Data : 0" HBox.hgrow="ALWAYS" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button onAction="#onFirstPage" prefHeight="28" prefWidth="34" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-weight: 700; -fx-background-radius: 5; -fx-cursor: hand;" text="«" />
                                <Button onAction="#onPrevPage" prefHeight="28" prefWidth="34" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-weight: 700; -fx-background-radius: 5; -fx-cursor: hand;" text="‹" />
                                <Label fx:id="lblPage" prefHeight="28" prefWidth="34" style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: WHITE; -fx-background-color: #1A3A8F; -fx-background-radius: 5; -fx-alignment: CENTER;" text="1" />
                                <Button onAction="#onNextPage" prefHeight="28" prefWidth="34" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-weight: 700; -fx-background-radius: 5; -fx-cursor: hand;" text="›" />
                                <Button onAction="#onLastPage" prefHeight="28" prefWidth="34" style="-fx-background-color: #F0F4FF; -fx-text-fill: #1A3A8F; -fx-font-weight: 700; -fx-background-radius: 5; -fx-cursor: hand;" text="»" />
                            </children>
                        </HBox>

                    </children>
                </VBox>

            </children>
        </VBox>
    </content>
</ScrollPane>
